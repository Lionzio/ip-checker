# Modelo do deploy/.env, lido pelo docker compose (Fase 0 e Fase 2). Copie para deploy/.env e
# troque cada valor; o deploy/.env nunca entra no Git (.gitignore). Use valores sem caracteres
# especiais de URL (letras, números, - e _), porque as senhas do banco entram em URLs de conexão:
#
#     python -c "import secrets; print(secrets.token_urlsafe(24))"

# Administrador do PostgreSQL: só o serviço migrate (de vida curta) recebe esta senha.
IPC_DB_ADMIN_PASSWORD=troque-esta-senha

# Usuário com que a API entra no banco (membro de ipc_app: lê e escreve, não apaga contas).
IPC_DB_API_PASSWORD=troque-esta-senha

# Senha inicial da conta do desenvolvedor (P-14), usada só na criação da conta. Precisa de pelo
# menos 9 caracteres, 1 letra maiúscula e 1 caractere especial; senão, a API não sobe.
IPC_DEV_INITIAL_PASSWORD=Troque-esta-senha-1

# --- Feedback por IA (Sprint 18) ------------------------------------------------------------
# Opcional. Sem nenhuma IA, o botão Gerar feedback funciona assim mesmo: o texto é montado por
# modelos, sem enviar nada para fora. Com IA, vão ao provedor só o código sem comentários, a
# anotação e o resultado, com o nome do aluno trocado por [ALUNO] (Q-16).
#
# IPC_LLM_PROVIDER: openai_compat (OpenAI, Groq, DeepSeek e outros compatíveis) ou gemini.
# IPC_LLM_BASE_URL: só no openai_compat fora da OpenAI, por exemplo
#   Groq:     https://api.groq.com/openai/v1
#   DeepSeek: https://api.deepseek.com
# IPC_LLM_MODEL: um modelo disponível na sua conta do provedor.

# IA principal.
IPC_LLM_PROVIDER=
IPC_LLM_BASE_URL=
IPC_LLM_MODEL=
IPC_LLM_API_KEY=

# IA de reserva: usada quando a principal falha, demora ou responde algo que não passa na
# validação. Prefira outro provedor, para as duas não caírem juntas.
IPC_LLM_FALLBACK_PROVIDER=
IPC_LLM_FALLBACK_BASE_URL=
IPC_LLM_FALLBACK_MODEL=
IPC_LLM_FALLBACK_API_KEY=
