{
  "openapi": "3.1.0",
  "info": {
    "title": "IP-Checker",
    "description": "Confere, **sem executar o código**, se a solução em Python de um aluno de Introdução à\nProgramação respeita as permissões da lista antes do envio ao Dikastis.\n\nO acesso é restrito à equipe da disciplina: as rotas, exceto `/health`, `/ready` e as de\nautenticação, exigem a sessão de uma conta ativa, aberta por `POST /api/v1/auth/login`.\n\nTodo erro segue o formato `{\"error\": {\"code\", \"message\", \"retry_after_s\"}}`. Toda resposta traz\no cabeçalho `X-Request-Id`. As respostas 429 e 503 trazem também o cabeçalho `Retry-After`.\n",
    "version": "1.0.0"
  },
  "paths": {
    "/api/v1/auth/login": {
      "post": {
        "tags": [
          "autenticação"
        ],
        "summary": "Entra com nome ou e-mail institucional e senha; abre a sessão no cookie",
        "operationId": "login_api_v1_auth_login_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AccountResponse"
                }
              }
            }
          },
          "401": {
            "description": "INVALID_CREDENTIALS: nome, e-mail ou senha incorretos (mensagem única).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "ACCOUNT_PENDING_VERIFICATION, ACCOUNT_PENDING_APPROVAL, ACCOUNT_REJECTED ou ACCOUNT_REMOVED (só com a senha correta), ou ORIGIN_MISMATCH: a requisição veio de outro site.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "DOMAIN_NOT_ALLOWED (e-mail fora de @cin.ufpe.br e @ufpe.br) ou INVALID_INPUT.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "429": {
            "description": "RATE_LIMITED: muitas tentativas. Veja retry_after_s.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "503": {
            "description": "DATABASE_UNAVAILABLE: o banco de contas não respondeu. Veja retry_after_s.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/logout": {
      "post": {
        "tags": [
          "autenticação"
        ],
        "summary": "Sai: encerra a sessão no servidor e apaga o cookie",
        "operationId": "logout_api_v1_auth_logout_post",
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "403": {
            "description": "ORIGIN_MISMATCH: a requisição veio de outro site.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "503": {
            "description": "DATABASE_UNAVAILABLE: o banco de contas não respondeu. Veja retry_after_s.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/me": {
      "get": {
        "tags": [
          "autenticação"
        ],
        "summary": "A conta logada (o tratamento só aparece aqui, para o próprio titular)",
        "operationId": "me_api_v1_auth_me_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AccountResponse"
                }
              }
            }
          },
          "401": {
            "description": "UNAUTHENTICATED: sem sessão de uma conta ativa.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "503": {
            "description": "DATABASE_UNAVAILABLE: o banco de contas não respondeu. Veja retry_after_s.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "sessao": []
          }
        ]
      }
    },
    "/api/v1/validate": {
      "post": {
        "tags": [
          "validação"
        ],
        "summary": "Confere se o código respeita as permissões da lista, sem executá-lo",
        "operationId": "validate_api_v1_validate_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ValidateRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidateResponse"
                }
              }
            }
          },
          "401": {
            "description": "UNAUTHENTICATED: sem sessão de uma conta ativa da equipe.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "ORIGIN_MISMATCH: a requisição veio de outro site.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "413": {
            "description": "PAYLOAD_TOO_LARGE: código acima de 51.200 bytes ou corpo acima de 128 KB.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "INVALID_INPUT (entrada inválida), LIST_NOT_ENABLED (lista não liberada), UNKNOWN_QUESTION (questão não cadastrada) ou ANALYSIS_LIMIT (código complexo demais).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "429": {
            "description": "RATE_LIMITED: muitas verificações da mesma conta ou da mesma rede em 1 minuto. Veja retry_after_s.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "503": {
            "description": "OVERLOADED (sem vaga para a análise), ANALYZER_UNAVAILABLE (o analisador não respondeu) ou DATABASE_UNAVAILABLE (o banco de contas não respondeu). Veja retry_after_s.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "sessao": []
          }
        ]
      }
    },
    "/api/v1/lists": {
      "get": {
        "tags": [
          "listas"
        ],
        "summary": "Listas habilitadas, com o título de cada uma",
        "operationId": "lists_api_v1_lists_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/ListInfo"
                  },
                  "type": "array",
                  "title": "Response Lists Api V1 Lists Get"
                }
              }
            }
          },
          "401": {
            "description": "UNAUTHENTICATED: sem sessão de uma conta ativa da equipe.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "503": {
            "description": "ANALYZER_UNAVAILABLE (o analisador não respondeu) ou DATABASE_UNAVAILABLE (o banco de contas não respondeu).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "sessao": []
          }
        ]
      }
    },
    "/health": {
      "get": {
        "tags": [
          "operação"
        ],
        "summary": "O processo da API está no ar",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/ready": {
      "get": {
        "tags": [
          "operação"
        ],
        "summary": "A API consegue atender: o analisador e o banco de contas respondem (monitorado pelo UptimeRobot)",
        "operationId": "ready_ready_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadyResponse"
                }
              }
            }
          },
          "503": {
            "description": "ANALYZER_UNAVAILABLE (o analisador não respondeu) ou DATABASE_UNAVAILABLE (o banco de contas não respondeu).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AccountResponse": {
        "properties": {
          "name": {
            "type": "string",
            "title": "Name"
          },
          "email": {
            "type": "string",
            "title": "Email",
            "description": "E-mail principal."
          },
          "course": {
            "type": "string",
            "title": "Course"
          },
          "treatment": {
            "type": "string",
            "enum": [
              "masculino",
              "feminino",
              "neutro"
            ],
            "title": "Treatment"
          },
          "role": {
            "type": "string",
            "enum": [
              "desenvolvedor",
              "professor",
              "monitor_chefe",
              "monitor"
            ],
            "title": "Role"
          },
          "role_label": {
            "type": "string",
            "title": "Role Label",
            "description": "Como o cargo aparece na interface; o desenvolvedor aparece como \"Monitor\"."
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "name",
          "email",
          "course",
          "treatment",
          "role",
          "role_label"
        ],
        "title": "AccountResponse",
        "description": "A conta de quem está logado. O tratamento só aparece para o próprio titular (FR-26)."
      },
      "ErrorCode": {
        "type": "string",
        "enum": [
          "PAYLOAD_TOO_LARGE",
          "INVALID_INPUT",
          "LIST_NOT_ENABLED",
          "UNKNOWN_QUESTION",
          "ANALYSIS_LIMIT",
          "RATE_LIMITED",
          "OVERLOADED",
          "ANALYZER_UNAVAILABLE",
          "UNAUTHENTICATED",
          "INVALID_CREDENTIALS",
          "DOMAIN_NOT_ALLOWED",
          "ACCOUNT_PENDING_VERIFICATION",
          "ACCOUNT_PENDING_APPROVAL",
          "ACCOUNT_REJECTED",
          "ACCOUNT_REMOVED",
          "ORIGIN_MISMATCH",
          "DATABASE_UNAVAILABLE"
        ],
        "title": "ErrorCode"
      },
      "ErrorDetail": {
        "properties": {
          "code": {
            "$ref": "#/components/schemas/ErrorCode"
          },
          "message": {
            "type": "string",
            "title": "Message"
          },
          "retry_after_s": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Retry After S"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "code",
          "message",
          "retry_after_s"
        ],
        "title": "ErrorDetail"
      },
      "ErrorResponse": {
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorDetail"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "error"
        ],
        "title": "ErrorResponse"
      },
      "HealthResponse": {
        "properties": {
          "status": {
            "type": "string",
            "const": "ok",
            "title": "Status"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "status"
        ],
        "title": "HealthResponse"
      },
      "ListInfo": {
        "properties": {
          "number": {
            "type": "integer",
            "maximum": 6.0,
            "minimum": 1.0,
            "title": "Number"
          },
          "title": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Title"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "number",
          "title"
        ],
        "title": "ListInfo"
      },
      "LoginRequest": {
        "properties": {
          "login": {
            "type": "string",
            "maxLength": 254,
            "minLength": 1,
            "title": "Login",
            "description": "Nome ou e-mail institucional (@cin.ufpe.br ou @ufpe.br)."
          },
          "password": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "title": "Password",
            "description": "Senha da conta. Nunca é registrada."
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "login",
          "password"
        ],
        "title": "LoginRequest"
      },
      "ReadyResponse": {
        "properties": {
          "status": {
            "type": "string",
            "const": "ready",
            "title": "Status"
          },
          "ruleset_version": {
            "type": "string",
            "pattern": "^\\d{4}\\.[12]\\.\\d+$",
            "title": "Ruleset Version"
          },
          "release": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Release",
            "description": "Commit implantado, quando informado pelo ambiente."
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "status",
          "ruleset_version"
        ],
        "title": "ReadyResponse"
      },
      "SyntaxErrorInfo": {
        "properties": {
          "line": {
            "type": "integer",
            "maximum": 1000000.0,
            "minimum": 1.0,
            "title": "Line"
          },
          "col": {
            "type": "integer",
            "maximum": 1000000.0,
            "minimum": 1.0,
            "title": "Col"
          },
          "message": {
            "type": "string",
            "maxLength": 1000,
            "minLength": 1,
            "title": "Message"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "line",
          "col",
          "message"
        ],
        "title": "SyntaxErrorInfo"
      },
      "ValidateRequest": {
        "properties": {
          "code": {
            "type": "string",
            "title": "Code",
            "description": "Código Python do aluno. Nunca é executado."
          },
          "list_number": {
            "type": "integer",
            "maximum": 6.0,
            "minimum": 1.0,
            "title": "List Number",
            "description": "Lista de exercícios (1 a 6)."
          },
          "question_id": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[A-Za-z0-9_-]{1,32}$"
              },
              {
                "type": "null"
              }
            ],
            "title": "Question Id",
            "description": "Questão, como L3-Q2. Sem questão, valem só as regras da lista."
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "code",
          "list_number"
        ],
        "title": "ValidateRequest"
      },
      "ValidateResponse": {
        "properties": {
          "request_id": {
            "type": "string",
            "title": "Request Id",
            "description": "Identificador da requisição (ULID), também no X-Request-Id."
          },
          "ruleset_version": {
            "type": "string",
            "pattern": "^\\d{4}\\.[12]\\.\\d+$",
            "title": "Ruleset Version"
          },
          "status": {
            "type": "string",
            "enum": [
              "valid",
              "invalid",
              "syntax_error"
            ],
            "title": "Status"
          },
          "list_number": {
            "type": "integer",
            "maximum": 6.0,
            "minimum": 1.0,
            "title": "List Number"
          },
          "question_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Question Id"
          },
          "notices": {
            "items": {
              "type": "string",
              "const": "QUESTION_RULES_NOT_APPLIED"
            },
            "type": "array",
            "title": "Notices"
          },
          "syntax_error": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/SyntaxErrorInfo"
              },
              {
                "type": "null"
              }
            ]
          },
          "violations": {
            "items": {
              "$ref": "#/components/schemas/Violation"
            },
            "type": "array",
            "title": "Violations"
          },
          "truncated": {
            "type": "boolean",
            "title": "Truncated",
            "description": "Verdadeiro quando havia mais de 200 violações."
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "request_id",
          "ruleset_version",
          "status",
          "list_number",
          "question_id",
          "notices",
          "syntax_error",
          "violations",
          "truncated"
        ],
        "title": "ValidateResponse"
      },
      "Violation": {
        "properties": {
          "rule_id": {
            "type": "string",
            "pattern": "^R-\\d{2}$",
            "title": "Rule Id"
          },
          "category": {
            "type": "string",
            "enum": [
              "ANULACAO",
              "PROIBIDO_NA_QUESTAO",
              "FORA_DA_LISTA",
              "NAO_CONSTA",
              "EXIGENCIA"
            ],
            "title": "Category"
          },
          "line": {
            "type": "integer",
            "maximum": 1000000.0,
            "minimum": 1.0,
            "title": "Line"
          },
          "col": {
            "type": "integer",
            "maximum": 1000000.0,
            "minimum": 1.0,
            "title": "Col"
          },
          "end_line": {
            "type": "integer",
            "maximum": 1000000.0,
            "minimum": 1.0,
            "title": "End Line"
          },
          "end_col": {
            "type": "integer",
            "maximum": 1000000.0,
            "minimum": 1.0,
            "title": "End Col"
          },
          "construct": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Construct"
          },
          "allowed_from_list": {
            "anyOf": [
              {
                "type": "integer",
                "maximum": 6.0,
                "minimum": 1.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Allowed From List"
          },
          "message": {
            "type": "string",
            "maxLength": 1000,
            "minLength": 1,
            "title": "Message"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "rule_id",
          "category",
          "line",
          "col",
          "end_line",
          "end_col",
          "construct",
          "allowed_from_list",
          "message"
        ],
        "title": "Violation"
      }
    },
    "securitySchemes": {
      "sessao": {
        "type": "apiKey",
        "description": "Sessão de uma conta ativa da equipe, criada por POST /api/v1/auth/login. HttpOnly, Secure e SameSite=Lax; o servidor guarda só o hash do identificador.",
        "in": "cookie",
        "name": "__Host-ipc_session"
      }
    }
  }
}
