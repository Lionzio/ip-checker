{
  "openapi": "3.1.0",
  "info": {
    "title": "IP-Checker",
    "description": "Confere, **sem executar o código**, se a solução em Python de um aluno de Introdução à\nProgramação respeita as permissões da lista antes do envio ao Dikastis.\n\nTodo erro segue o formato `{\"error\": {\"code\", \"message\", \"retry_after_s\"}}`. Toda resposta traz\no cabeçalho `X-Request-Id`.\n",
    "version": "1.0.0"
  },
  "paths": {
    "/api/v1/validate": {
      "post": {
        "tags": [
          "validação"
        ],
        "summary": "Confere se o código respeita as permissões da lista, sem executá-lo",
        "operationId": "validate_api_v1_validate_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ValidateRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidateResponse"
                }
              }
            }
          },
          "413": {
            "description": "PAYLOAD_TOO_LARGE: código acima de 51.200 bytes ou corpo acima de 128 KB.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "INVALID_INPUT (entrada inválida), LIST_NOT_ENABLED (lista não liberada), UNKNOWN_QUESTION (questão não cadastrada) ou ANALYSIS_LIMIT (código complexo demais).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "503": {
            "description": "ANALYZER_UNAVAILABLE: o analisador não respondeu. Veja retry_after_s.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/lists": {
      "get": {
        "tags": [
          "listas"
        ],
        "summary": "Listas habilitadas, com o título de cada uma",
        "operationId": "lists_api_v1_lists_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/ListInfo"
                  },
                  "type": "array",
                  "title": "Response Lists Api V1 Lists Get"
                }
              }
            }
          },
          "503": {
            "description": "ANALYZER_UNAVAILABLE: o analisador não respondeu.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/health": {
      "get": {
        "tags": [
          "operação"
        ],
        "summary": "O processo da API está no ar",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/ready": {
      "get": {
        "tags": [
          "operação"
        ],
        "summary": "A API consegue validar código: o analisador responde (monitorado pelo UptimeRobot)",
        "operationId": "ready_ready_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadyResponse"
                }
              }
            }
          },
          "503": {
            "description": "ANALYZER_UNAVAILABLE: o analisador não respondeu.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ErrorCode": {
        "type": "string",
        "enum": [
          "PAYLOAD_TOO_LARGE",
          "INVALID_INPUT",
          "LIST_NOT_ENABLED",
          "UNKNOWN_QUESTION",
          "ANALYSIS_LIMIT",
          "ANALYZER_UNAVAILABLE"
        ],
        "title": "ErrorCode"
      },
      "ErrorDetail": {
        "properties": {
          "code": {
            "$ref": "#/components/schemas/ErrorCode"
          },
          "message": {
            "type": "string",
            "title": "Message"
          },
          "retry_after_s": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Retry After S"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "code",
          "message",
          "retry_after_s"
        ],
        "title": "ErrorDetail"
      },
      "ErrorResponse": {
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorDetail"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "error"
        ],
        "title": "ErrorResponse"
      },
      "HealthResponse": {
        "properties": {
          "status": {
            "type": "string",
            "const": "ok",
            "title": "Status"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "status"
        ],
        "title": "HealthResponse"
      },
      "ListInfo": {
        "properties": {
          "number": {
            "type": "integer",
            "maximum": 6.0,
            "minimum": 1.0,
            "title": "Number"
          },
          "title": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Title"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "number",
          "title"
        ],
        "title": "ListInfo"
      },
      "ReadyResponse": {
        "properties": {
          "status": {
            "type": "string",
            "const": "ready",
            "title": "Status"
          },
          "ruleset_version": {
            "type": "string",
            "pattern": "^\\d{4}\\.[12]\\.\\d+$",
            "title": "Ruleset Version"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "status",
          "ruleset_version"
        ],
        "title": "ReadyResponse"
      },
      "SyntaxErrorInfo": {
        "properties": {
          "line": {
            "type": "integer",
            "maximum": 1000000.0,
            "minimum": 1.0,
            "title": "Line"
          },
          "col": {
            "type": "integer",
            "maximum": 1000000.0,
            "minimum": 1.0,
            "title": "Col"
          },
          "message": {
            "type": "string",
            "maxLength": 1000,
            "minLength": 1,
            "title": "Message"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "line",
          "col",
          "message"
        ],
        "title": "SyntaxErrorInfo"
      },
      "ValidateRequest": {
        "properties": {
          "code": {
            "type": "string",
            "title": "Code",
            "description": "Código Python do aluno. Nunca é executado."
          },
          "list_number": {
            "type": "integer",
            "maximum": 6.0,
            "minimum": 1.0,
            "title": "List Number",
            "description": "Lista de exercícios (1 a 6)."
          },
          "question_id": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[A-Za-z0-9_-]{1,32}$"
              },
              {
                "type": "null"
              }
            ],
            "title": "Question Id",
            "description": "Questão, como L3-Q2. Sem questão, valem só as regras da lista."
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "code",
          "list_number"
        ],
        "title": "ValidateRequest"
      },
      "ValidateResponse": {
        "properties": {
          "request_id": {
            "type": "string",
            "title": "Request Id",
            "description": "Identificador da requisição (ULID), também no X-Request-Id."
          },
          "ruleset_version": {
            "type": "string",
            "pattern": "^\\d{4}\\.[12]\\.\\d+$",
            "title": "Ruleset Version"
          },
          "status": {
            "type": "string",
            "enum": [
              "valid",
              "invalid",
              "syntax_error"
            ],
            "title": "Status"
          },
          "list_number": {
            "type": "integer",
            "maximum": 6.0,
            "minimum": 1.0,
            "title": "List Number"
          },
          "question_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Question Id"
          },
          "notices": {
            "items": {
              "type": "string",
              "const": "QUESTION_RULES_NOT_APPLIED"
            },
            "type": "array",
            "title": "Notices"
          },
          "syntax_error": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/SyntaxErrorInfo"
              },
              {
                "type": "null"
              }
            ]
          },
          "violations": {
            "items": {
              "$ref": "#/components/schemas/Violation"
            },
            "type": "array",
            "title": "Violations"
          },
          "truncated": {
            "type": "boolean",
            "title": "Truncated",
            "description": "Verdadeiro quando havia mais de 200 violações."
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "request_id",
          "ruleset_version",
          "status",
          "list_number",
          "question_id",
          "notices",
          "syntax_error",
          "violations",
          "truncated"
        ],
        "title": "ValidateResponse"
      },
      "Violation": {
        "properties": {
          "rule_id": {
            "type": "string",
            "pattern": "^R-\\d{2}$",
            "title": "Rule Id"
          },
          "category": {
            "type": "string",
            "enum": [
              "ANULACAO",
              "PROIBIDO_NA_QUESTAO",
              "FORA_DA_LISTA",
              "NAO_CONSTA",
              "EXIGENCIA"
            ],
            "title": "Category"
          },
          "line": {
            "type": "integer",
            "maximum": 1000000.0,
            "minimum": 1.0,
            "title": "Line"
          },
          "col": {
            "type": "integer",
            "maximum": 1000000.0,
            "minimum": 1.0,
            "title": "Col"
          },
          "end_line": {
            "type": "integer",
            "maximum": 1000000.0,
            "minimum": 1.0,
            "title": "End Line"
          },
          "end_col": {
            "type": "integer",
            "maximum": 1000000.0,
            "minimum": 1.0,
            "title": "End Col"
          },
          "construct": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Construct"
          },
          "allowed_from_list": {
            "anyOf": [
              {
                "type": "integer",
                "maximum": 6.0,
                "minimum": 1.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Allowed From List"
          },
          "message": {
            "type": "string",
            "maxLength": 1000,
            "minLength": 1,
            "title": "Message"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "rule_id",
          "category",
          "line",
          "col",
          "end_line",
          "end_col",
          "construct",
          "allowed_from_list",
          "message"
        ],
        "title": "Violation"
      }
    }
  }
}
