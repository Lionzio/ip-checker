{
  "manifest_version": 3,
  "name": "IP-Checker: listas do Dikastis",
  "short_name": "IP-Checker",
  "version": "0.50.0",
  "description": "Lê as listas e os enunciados de IP no Dikastis (com a sua sessão) e envia ao IP-Checker só o que é novo ou mudou.",
  "key": "",
  "minimum_chrome_version": "120",
  "permissions": ["storage"],
  "host_permissions": ["https://dikastis.com.br/*", "https://ip-checker-red-phi.vercel.app/*"],
  "optional_host_permissions": ["http://127.0.0.1/*", "http://localhost/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": { "default_popup": "popup.html", "default_title": "IP-Checker: listas do Dikastis" },
  "content_scripts": [
    {
      "matches": ["https://dikastis.com.br/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
